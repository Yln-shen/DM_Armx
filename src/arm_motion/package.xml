<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_motion</name>
  <version>0.1.0</version>
  <description>
    运动执行件：给 JointTrajectoryController 发轨迹的**非阻塞**客户端（MotionClient）。
    2026-10-07 从 arm_application/safe_park_node.cpp 抽出（M9.0），**行为逐条等价**。
    将来 arm_motion 的 ExecuteMotion action server（IK/规划/命名目标/直线段）也落在这个包里。
  </description>
  <maintainer email="3432607998@qq.com">Yln-shen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- 关节限位（模型坐标）：由 arm_description 构建期从 joint.yaml + align.yaml 生成并导出。
       这里是**护栏**的唯一真源（JTC 不校验限位，越界会顶在机械硬限位上堵转，见陷阱 #59）。 -->
  <depend>arm_description</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
