<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motor_driver_hardware</name>
  <version>0.0.0</version>
  <description>
    DM_Armx 的 C++ 侧：协议层 + 串口 + 总线 + 关节（dm_hardware 库，不依赖 ROS），
    以及 ros2_control 的 SystemInterface 插件（DmSystemInterface）。
  </description>
  <maintainer email="3432607998@qq.com">ylnn</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 插件那层才依赖 ROS；dm_hardware 库本身不依赖 -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
