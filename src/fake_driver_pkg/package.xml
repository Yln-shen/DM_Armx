<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fake_driver_pkg</name>
  <version>0.1.0</version>
  <description>Fake Driver（虚拟机械臂执行器，移植自 reBot_Arm_Mujoco-DM 的 rebotarmcontroller/fake_driver.py）。不接电机，提供与真机驱动一致的 ROS 接口，供仿真栈和“仿真↔真机同接口切换”使用。</description>
  <maintainer email="3432607998@qq.com">ylnn</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rebotarm_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
