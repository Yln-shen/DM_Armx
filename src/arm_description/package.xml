<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_description</name>
  <version>0.0.0</version>
  <description>
    DM_Armx 6 轴机械臂的 URDF/xacro 描述。几何（mesh/URDF）取自
    github.com/Yang-Ci/Borot-Arm_Mujoco.git（CERN-OHL-W-2.0，见 LICENSE-CERN-OHL-W-2.0），
    本包自写的部分（xacro 装配、launch、rviz、文档）为 Apache-2.0。
  </description>
  <maintainer email="3432607998@qq.com">ylnn</maintainer>
  <license>Apache-2.0</license>
  <license>CERN-OHL-W-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
