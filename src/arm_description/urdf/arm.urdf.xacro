<?xml version="1.0"?>
<!-- DM_Armx 6 轴机械臂描述（主文件）

  展开：xacro arm.urdf.xacro use_gripper:=false > arm.urdf
  看模型：ros2 launch arm_description display.launch.py

  ✅ joint limit 已是**本项目标定限位换算到模型坐标**的结果（2026-10-04 M1b 真机实测）：
     q_urdf = sign * q_ours + zero_shift，sign/zero_shift 见 config/align.yaml；
     换算公式与结果见 inc/arm_geometry.urdf.xacro 顶部注释。
     注意我们的标定限位比上游窄很多（j1 只有 ±0.1 rad 左右）；j2/j3 的下界当天放宽过
     （让"自然停放姿态"落进限位内，见 inc/arm_geometry.urdf.xacro 顶部注释）。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dm_armx">
  <xacro:arg name="use_gripper" default="false"/>

  <xacro:include filename="inc/arm_geometry.urdf.xacro"/>
  <xacro:include filename="inc/gripper.urdf.xacro"/>
  <xacro:include filename="inc/arm.ros2_control.xacro"/>

  <!-- MoveIt 用的末端参考点（相对 end_link，偏移取自参考模型） -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <origin xyz="-0.105 0 0" rpy="0 0 0"/>
    <parent link="end_link"/>
    <child link="gripper_tcp"/>
  </joint>

  <xacro:if value="$(arg use_gripper)">
    <xacro:gripper_links/>
  </xacro:if>

  <xacro:arm_ros2_control/>
</robot>
