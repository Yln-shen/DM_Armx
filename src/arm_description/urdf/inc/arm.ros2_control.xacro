<?xml version="1.0"?>
<!-- ros2_control 硬件接口。两条分支由 `use_mock` 选：

     - `use_mock:=true`（默认）：ros2_control 自带的 mock —— 不接真机就能把
       controller_manager → joint_trajectory_controller → joint_state_broadcaster 跑通（M2 的验收链路）。
     - `use_mock:=false`：真插件 `motor_driver_hardware/DmSystemInterface`。关节参数**由 xacro 直接从**
       - `motor_driver/config/joint.yaml`（direction / offset / 档位 / 软限位 / 串口设备）
       - `arm_description/config/align.yaml`（模型对齐 sign / zero_shift）
       **读出来**生成 <param> ⇒ 单一真源不破，不用在两处维护同一批数字。

     ⚠️ **控制模式固定 POS_VEL（`0x0A = 2`）**，MIT 已砍（2026-10-14）：本链不需要关节力矩，
        而折叠位的重力由机械结构承载（实测：失能 5 s 零漂移）。`effort` 命令接口保留为**空插槽**
        （本层不读），将来若要加力矩控制器不必改本文件。
        ⇒ `mit_gains.yaml`（kp_hold/kd_hold/ki_hold/friction_*）与 `torque_max` **不再进 <param>**。

     ⚠️ mock 分支的 `initial_value` 是**起始姿态**，必须落在换算后的限位里（见 arm_geometry.urdf.xacro 顶部）：
        取 (1.51, -1.0, -0.9, 0.3, 0.0, 0.0)，FK 验证不自交。写 0 会落在 j1~j3 换算后的限位之外。
     ⚠️ 真机分支默认 `enable_on_activate:=false`：**只读**（不使能、不发控制帧），
        首轮验收先这么跑；要动电机必须显式传 true。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_mock" default="true"/>
  <xacro:arg name="enable_on_activate" default="false"/>
  <xacro:arg name="vlim" default="1.0"/>
  <xacro:arg name="joint_cfg" default="$(find motor_driver)/config/joint.yaml"/>
  <xacro:arg name="align_cfg" default="$(find arm_description)/config/align.yaml"/>

  <xacro:property name="arm_cfg" value="${xacro.load_yaml('$(arg joint_cfg)')}"/>
  <xacro:property name="align_cfg" value="${xacro.load_yaml('$(arg align_cfg)')}"/>

  <!-- mock 的一个关节：起始姿态用 initial（模型坐标） -->
  <xacro:macro name="mock_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <!-- effort 命令接口（**空插槽**）：真机插件导出它但从不读；mock 分支声明同一套，
           否则两条链的接口集不一致、控制器配置没法共用。 -->
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
      <state_interface name="velocity"/>
      <!-- effort 状态：插件导出的是电机反馈里的**电流估计**力矩（不是力矩传感器）。
           mock 里没人给值 ⇒ 恒 NaN/0，但声明上必须与真机一致。 -->
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- 真机的一个关节：参数全部从上面两个 yaml 里取 -->
  <xacro:macro name="real_joint" params="name">
    <xacro:property name="jcfg" value="${arm_cfg['joints'][name]}"/>
    <xacro:property name="acfg" value="${align_cfg['joints'][name]}"/>
    <joint name="${name}">
      <command_interface name="position"/>
      <!-- effort 命令接口：**空插槽**（见文件头）。本层永远不读它。 -->
      <command_interface name="effort"/>
      <state_interface name="position"/>     <!-- 真值从硬件读，不给 initial_value -->
      <state_interface name="velocity"/>
      <!-- effort 状态：**电流估计**力矩（模型坐标，矢量只乘 sign）。用途是
           "POS_VEL 托住时读真实保持力矩"和 ROS 侧监控 —— 别当力矩传感器用。 -->
      <state_interface name="effort"/>
      <param name="motor_id">${jcfg['slave_id']}</param>
      <param name="motor_type">${jcfg['motor_type']}</param>
      <param name="direction">${jcfg['direction']}</param>
      <param name="offset">${jcfg['offset']}</param>
      <param name="p_max">${jcfg['limit'][0]}</param>
      <param name="v_max">${jcfg['limit'][1]}</param>
      <param name="t_max">${jcfg['limit'][2]}</param>
      <param name="position_min">${jcfg['position_min']}</param>
      <param name="position_max">${jcfg['position_max']}</param>
      <!-- 模型对齐：q_urdf = sign · q_ours + zero_shift -->
      <param name="sign">${acfg['sign']}</param>
      <param name="zero_shift">${acfg['zero_shift']}</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_ros2_control" params="name:=ArmSystem">
    <ros2_control name="${name}" type="system">
      <xacro:if value="$(arg use_mock)">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg use_mock)">
        <hardware>
          <plugin>motor_driver_hardware/DmSystemInterface</plugin>
          <param name="device">${arm_cfg['channel']}</param>
          <param name="baud">${arm_cfg['baud']}</param>
          <param name="enable_on_activate">$(arg enable_on_activate)</param>
          <param name="vlim">$(arg vlim)</param>
        </hardware>
      </xacro:unless>

      <xacro:if value="$(arg use_mock)">
        <xacro:mock_joint name="joint1" initial="1.51"/>
        <xacro:mock_joint name="joint2" initial="-1.0"/>
        <xacro:mock_joint name="joint3" initial="-0.9"/>
        <xacro:mock_joint name="joint4" initial="0.3"/>
        <xacro:mock_joint name="joint5" initial="0.0"/>
        <xacro:mock_joint name="joint6" initial="0.0"/>
      </xacro:if>
      <xacro:unless value="$(arg use_mock)">
        <xacro:real_joint name="joint1"/>
        <xacro:real_joint name="joint2"/>
        <xacro:real_joint name="joint3"/>
        <xacro:real_joint name="joint4"/>
        <xacro:real_joint name="joint5"/>
        <xacro:real_joint name="joint6"/>
      </xacro:unless>
    </ros2_control>
  </xacro:macro>

</robot>
