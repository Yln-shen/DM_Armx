<?xml version="1.0"?>
<!-- 夹爪几何（finger_left/right，prismatic）。默认不加载：主文件用 use_gripper 参数控制。

  ⚠️ 两个手指的 inertial 故意留**零**：真源是 config/gravity_identified.yaml 的 `gripper:` 段，
     由 scripts/apply_identified_inertia.py（带 gripper 开关）注入 —— 夹爪没辨识过，那里的数是占位。
     这里写零是为了让 `use_gripper:=true` 的**几何/显示**与**动力学**只有一个质量真源。 -->
<robot name="dm_armx_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gripper_links">
    <link name="finger_left_link">
      <!-- 质量真源见文件头注释（脚本带 gripper 开关时注入） -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.0" />
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
      <visual name="finger_left_body">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_left_finger_finger_black.stl" />
        </geometry>
        <material name="gripper_finger_black" />
      </visual>
      <visual name="finger_left_carriage">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_left_finger_carriage_grey.stl" />
        </geometry>
        <material name="gripper_carriage_grey" />
      </visual>
      <visual name="finger_left_travel_stop">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_left_finger_travel_stop_yellow.stl" />
        </geometry>
        <material name="gripper_seeed_yellow" />
      </visual>
      <visual name="finger_left_crossed_rack">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_left_finger_rack_metal.stl" />
        </geometry>
        <material name="gripper_rack_metal" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/left_finger.stl" />
        </geometry>
      </collision>
    </link>
    <link name="finger_right_link">
      <!-- 质量真源见文件头注释（脚本带 gripper 开关时注入） -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.0" />
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
      <visual name="finger_right_body">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_right_finger_finger_black.stl" />
        </geometry>
        <material name="gripper_finger_black" />
      </visual>
      <visual name="finger_right_carriage">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_right_finger_carriage_grey.stl" />
        </geometry>
        <material name="gripper_carriage_grey" />
      </visual>
      <visual name="finger_right_travel_stop">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_right_finger_travel_stop_yellow.stl" />
        </geometry>
        <material name="gripper_seeed_yellow" />
      </visual>
      <visual name="finger_right_crossed_rack">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/colored_right_finger_rack_metal.stl" />
        </geometry>
        <material name="gripper_rack_metal" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://arm_description/meshes/right_finger.stl" />
        </geometry>
      </collision>
    </link>
    <joint name="finger_left" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="end_link" />
      <child link="finger_left_link" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="0.05" effort="8" velocity="0.08" />
    </joint>
    <joint name="finger_right" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="end_link" />
      <child link="finger_right_link" />
      <axis xyz="0 1 0" />
      <limit lower="-0.05" upper="0" effort="8" velocity="0.08" />
      <mimic joint="finger_left" multiplier="-1" offset="0" />
    </joint>
  </xacro:macro>
</robot>
